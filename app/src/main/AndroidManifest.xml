<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 声明给 root 管理器看（老式 Superuser 用它避免"未定义"红字警告） -->
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />

    <!-- 与 PC 调试通道通信（仅开发期使用） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:label="WHX Automation"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <service
            android:name=".AutomationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".TaskStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.whx.automation.STOP_TASK" />
            </intent-filter>
        </receiver>

        <!-- PC 工具链的运行入口：广播驱动，不依赖界面生命周期 -->
        <receiver
            android:name=".RunScriptReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.whx.automation.RUN_SCRIPT" />
            </intent-filter>
        </receiver>

        <!-- 定时任务：需要 exported 才能被 PC 工具链增删（见 ScheduleReceiver 注释的安全说明） -->
        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.whx.automation.SCHEDULE_RUN" />
                <action android:name="com.whx.automation.SCHEDULE_ADD" />
                <action android:name="com.whx.automation.SCHEDULE_REMOVE" />
                <action android:name="com.whx.automation.SCHEDULE_LIST" />
            </intent-filter>
        </receiver>

        <service
            android:name=".access.WhxAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 启动器入口用 activity-alias：这样可以在运行时切换图标与名称，
             不需要解析/改写 resources.arsc（icon 是资源 id，不是字符串） -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Sprite1"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_sprite1"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Sprite2"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_sprite2"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Sprite3"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_sprite3"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Sprite4"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_sprite4"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
